# Server-side origin; omit to explore demo data. No path, credentials or query.
SNM_API_URL=http://127.0.0.1:3000

# When the server holds a backend token, authenticate frontend visitors too.
# Replace both fake tokens before use; never commit actual credentials.
# SNM_API_TOKEN=fake-backend-example-token
# SNM_FRONTEND_TOKEN=fake-visitor-example-token

# Only when an authenticated reverse proxy is the exclusive ingress:
# SNM_TRUST_AUTH_PROXY=true

# Safe listener defaults.
# HOST=127.0.0.1
# PORT=4444
